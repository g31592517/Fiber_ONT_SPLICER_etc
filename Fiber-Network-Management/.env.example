# ---- required in production --------------------------------------------------
FNMS_ENVIRONMENT=production
POSTGRES_PASSWORD=change-me-strong-db-password
# 64+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(64))"
FNMS_JWT_SECRET=change-me
# Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FNMS_ENCRYPTION_KEY=change-me
FNMS_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# ---- optional -----------------------------------------------------------------
FNMS_CORS_ORIGINS=["http://localhost:8080"]
FNMS_ACCESS_TOKEN_MINUTES=60
FNMS_DEFAULT_POLL_INTERVAL_SECONDS=300
FNMS_MIN_POLL_INTERVAL_SECONDS=60
# Built-in simulator (disable on production networks unless you want demo OLTs)
FNMS_SIMULATOR_ENABLED=false
# Keep false until an experimental adapter has been validated against your equipment
FNMS_ALLOW_UNVERIFIED_ADAPTER_WRITES=false
# Map tiles (empty = schematic coordinate plot only, no external map service)
FNMS_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
FNMS_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
